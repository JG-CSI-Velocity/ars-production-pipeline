# Python cache
__pycache__/
**/*.pyc

# Pipeline output directories (contain client data)
02_Presentations/
!02_Presentations/.gitkeep
04_Logs/
!04_Logs/.gitkeep

# Virtual environment
.venv/

# OS files
.DS_Store

.superpowers/

# Claude Code working notes — local-only, not for the operator's work folder
CLAUDE.md

# Operator's working slide manifest — tracked as SLIDE_MANIFEST.template.xlsx
# only. Each operator keeps their own SLIDE_MANIFEST.xlsx with their Keep?
# decisions and per-slide notes; git pull will never overwrite it.
SLIDE_MANIFEST.xlsx

# Local planning / dev scratch — per-developer, never shipped
.planning/
Legacy/

# Formatting working directories — contain client data
00_Formatting/Incoming/
00_Formatting/Unprocessed ODDs/
00_Formatting/01-Data-Ready for Formatting/
00_Formatting/02-Data-Ready for Analysis/

# Analysis outputs — generated per run, contain client data
01_Analysis/output/
01_Analysis/00-Scripts/output/
01_Analysis/01_Completed_Analysis/
01_Analysis/Actionable Lists for Clients/
# CWD fallback for cross-sell exports (standalone/notebook runs): contains
# account-level member PII the moment a list is generated -- never track.
01_Analysis/00-Scripts/Actionable Lists for Clients/
Actionable Lists for Clients/
01_Analysis/sample holder/
01_Analysis/**/sample holder/
01_Analysis/run_log.txt
01_Analysis/competition_*.png
01_Analysis/competition_diagnostic.txt
output/

# Recordings, decks, archives parked at repo root. Client workbooks/exports
# parked at the root are data, not source -- only the manifest template is
# tracked.
/*.mp4
/*.pptx
/*.xlsx
/*.csv
!/SLIDE_MANIFEST.template.xlsx
_archive/

# Windows shortcuts
*.lnk

# Persistent cross-run chart cache (mailer summaries/combos)
.chart_cache/
.odd_cache/

# Runtime UI state -- written by the running server, not source (#232)
03_Config/schedules.json
# Stray local copy of the M: tree accidentally created on dev machines (#232)
00_Formatting/M:\ARS/

# Understand-Anything knowledge-graph tooling output (generated, not source)
.understand-anything/

